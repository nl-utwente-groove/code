<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="network" nsURI="http://groove.utwente.nl/ecore/network" nsPrefix="network">
  <eClassifiers xsi:type="ecore:EClass" name="Network">
    <eStructuralFeatures xsi:type="ecore:EReference" name="stations" lowerBound="2"
        upperBound="4" ordered="false" containment="true" eType="#//Station"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Station">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="next" eType="#//Station"
        eOpposite="#//Station/previous"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="previous" eType="#//Station"
        eOpposite="#//Station/next"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="route" upperBound="-1"
        eType="#//Station"/>
  </eClassifiers>
</ecore:EPackage>
