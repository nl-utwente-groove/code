<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gxl xmlns="http://www.gupro.de/GXL/gxl-1.0.dtd">
    <graph role="rule" edgeids="true" edgemode="directed" id="addToken">
        <attr name="$version">
            <string>curly</string>
        </attr>
        <node id="n0">
            <attr name="layout">
                <string>249 171 19 19</string>
            </attr>
        </node>
        <node id="n1">
            <attr name="layout">
                <string>434 159 48 36</string>
            </attr>
        </node>
        <edge from="n0" to="n0" id="e0">
            <attr name="label">
                <string>type:Hub</string>
            </attr>
        </edge>
        <edge from="n0" to="n0" id="e1">
            <attr name="label">
                <string>let:tokens=tokens-1</string>
            </attr>
        </edge>
        <edge from="n0" to="n0" id="e2">
            <attr name="label">
                <string>test:tokens&gt;0</string>
            </attr>
        </edge>
        <edge from="n0" to="n1" id="e3">
            <attr name="label">
                <string>to</string>
            </attr>
        </edge>
        <edge from="n1" to="n1" id="e4">
            <attr name="label">
                <string>type:Leaf</string>
            </attr>
        </edge>
        <edge from="n1" to="n1" id="e5">
            <attr name="label">
                <string>cnew:flag:token</string>
            </attr>
        </edge>
    </graph>
</gxl>
