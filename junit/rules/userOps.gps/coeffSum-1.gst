            <string>curly</string>
        </attr>
        <node id="n">
            <attr name="layout">
                <string>80 80 60 30</string>
            </attr>
        </node>
        <edge from="n" to="n">
            <attr name="label">
                <string>let:p=UserTypePoly("p")</string>
            </attr>
        </edge>
    </graph>
</gxl>
