<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gxl xmlns="http://www.gupro.de/GXL/gxl-1.0.dtd">
    <graph role="rule" edgeids="false" edgemode="directed" id="polyConst">
        <attr name="$version">
            <string>curly</string>
        </attr>
        <node id="n">
            <attr name="layout">
                <string>80 80 60 30</string>
            </attr>
        </node>
        <node id="v">
            <attr name="layout">
                <string>310 80 60 30</string>
            </attr>
        </node>
        <edge from="n" to="n">
            <attr name="label">
                <string>new:flag:found</string>
            </attr>
        </edge>
        <edge from="v" to="v">
            <attr name="label">
                <string>user:UserTypePoly("p", 1, 2, 3)</string>
            </attr>
        </edge>
        <edge from="n" to="v">
            <attr name="label">
                <string>x</string>
            </attr>
        </edge>
    </graph>
</gxl>
