<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gxl xmlns="http://www.gupro.de/GXL/gxl-1.0.dtd">
    <graph role="rule" edgeids="false" edgemode="directed" id="digitNodes">
        <attr name="$version">
            <string>curly</string>
        </attr>
        <node id="a">
            <attr name="layout">
                <string>80 80 60 30</string>
            </attr>
        </node>
        <node id="f">
            <attr name="layout">
                <string>250 80 60 30</string>
            </attr>
        </node>
        <node id="c">
            <attr name="layout">
                <string>420 80 60 30</string>
            </attr>
        </node>
        <edge from="a" to="a">
            <attr name="label">
                <string>id:a</string>
            </attr>
        </edge>
        <edge from="a" to="a">
            <attr name="label">
                <string>type:A</string>
            </attr>
        </edge>
        <edge from="f" to="f">
            <attr name="label">
                <string>forall:</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>new:</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>type:C</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>let:v = digits(a.n)</string>
            </attr>
        </edge>
        <edge from="c" to="f">
            <attr name="label">
                <string>at</string>
            </attr>
        </edge>
    </graph>
</gxl>
