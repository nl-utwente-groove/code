<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gxl xmlns="http://www.gupro.de/GXL/gxl-1.0.dtd">
    <graph role="rule" edgeids="false" edgemode="directed" id="unmarked">
        <attr name="$version">
            <string>curly</string>
        </attr>
        <attr name="actionRole">
            <string>invariant</string>
        </attr>
        <node id="n0">
            <attr name="layout">
                <string>100 80 60 40</string>
            </attr>
        </node>
        <edge to="n0" from="n0">
            <attr name="label">
                <string>cell</string>
            </attr>
        </edge>
        <edge to="n0" from="n0">
            <attr name="label">
                <string>not:marked</string>
            </attr>
        </edge>
    </graph>
</gxl>
