<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gxl xmlns="http://www.gupro.de/GXL/gxl-1.0.dtd">
    <graph role="rule" edgeids="false" edgemode="directed" id="fill">
        <attr name="$version">
            <string>curly</string>
        </attr>
        <node id="t">
            <attr name="layout">
                <string>80 80 60 30</string>
            </attr>
        </node>
        <node id="f">
            <attr name="layout">
                <string>250 80 60 30</string>
            </attr>
        </node>
        <node id="c">
            <attr name="layout">
                <string>420 80 60 30</string>
            </attr>
        </node>
        <edge from="t" to="t">
            <attr name="label">
                <string>id:t</string>
            </attr>
        </edge>
        <edge from="t" to="t">
            <attr name="label">
                <string>type:Table</string>
            </attr>
        </edge>
        <edge from="t" to="t">
            <attr name="label">
                <string>not:flag:filled</string>
            </attr>
        </edge>
        <edge from="t" to="t">
            <attr name="label">
                <string>new:flag:filled</string>
            </attr>
        </edge>
        <edge from="f" to="f">
            <attr name="label">
                <string>forall:</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>new:</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>type:Cell</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>let:idx = range(t.n)</string>
            </attr>
        </edge>
        <edge from="c" to="f">
            <attr name="label">
                <string>at</string>
            </attr>
        </edge>
    </graph>
</gxl>
