<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gxl xmlns="http://www.gupro.de/GXL/gxl-1.0.dtd">
    <graph role="rule" edgeids="false" edgemode="directed" id="mark">
        <attr name="$version">
            <string>curly</string>
        </attr>
        <node id="t">
            <attr name="layout">
                <string>80 80 60 30</string>
            </attr>
        </node>
        <node id="n">
            <attr name="layout">
                <string>250 80 60 30</string>
            </attr>
        </node>
        <node id="c">
            <attr name="layout">
                <string>420 80 60 30</string>
            </attr>
        </node>
        <node id="x">
            <attr name="layout">
                <string>80 190 60 30</string>
            </attr>
        </node>
        <node id="p">
            <attr name="layout">
                <string>250 190 60 30</string>
            </attr>
        </node>
        <edge from="t" to="t">
            <attr name="label">
                <string>type:Table</string>
            </attr>
        </edge>
        <edge from="n" to="n">
            <attr name="label">
                <string>int:</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>type:Cell</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>not:flag:marked</string>
            </attr>
        </edge>
        <edge from="c" to="c">
            <attr name="label">
                <string>new:flag:marked</string>
            </attr>
        </edge>
        <edge from="x" to="x">
            <attr name="label">
                <string>int:</string>
            </attr>
        </edge>
        <edge from="p" to="p">
            <attr name="label">
                <string>prod:</string>
            </attr>
        </edge>
        <edge from="t" to="n">
            <attr name="label">
                <string>n</string>
            </attr>
        </edge>
        <edge from="c" to="x">
            <attr name="label">
                <string>idx</string>
            </attr>
        </edge>
        <edge from="p" to="n">
            <attr name="label">
                <string>arg:0</string>
            </attr>
        </edge>
        <edge from="p" to="x">
            <attr name="label">
                <string>int:range</string>
            </attr>
        </edge>
    </graph>
</gxl>
