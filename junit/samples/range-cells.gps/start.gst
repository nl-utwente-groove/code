<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<gxl xmlns="http://www.gupro.de/GXL/gxl-1.0.dtd">
    <graph role="graph" edgeids="false" edgemode="directed" id="start">
        <attr name="$version">
            <string>curly</string>
        </attr>
        <node id="t">
            <attr name="layout">
                <string>80 80 60 30</string>
            </attr>
        </node>
        <edge from="t" to="t">
            <attr name="label">
                <string>type:Table</string>
            </attr>
        </edge>
        <edge from="t" to="t">
            <attr name="label">
                <string>let:n = 4</string>
            </attr>
        </edge>
    </graph>
</gxl>
