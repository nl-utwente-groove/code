<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.utwente.groove</groupId>
	<artifactId>groove-yfiles</artifactId>
	<version>${revision}</version>

	<!-- The yFiles graph-visualisation backend of GROOVE (gh #909): an optionally
	     compiled unit, deliberately NOT a module of the main reactor. It depends on
	     the GROOVE artifact and on the licensed yFiles library, which is available
	     only from a developer's local Maven repository; the main build
	     (git clone && mvn package) never needs it. See README.md in this directory. -->

	<properties>
		<!-- the GROOVE version this backend is built against. The default MUST equal
		     the revision property of the main pom: with equal versions, Eclipse
		     resolves the dependency from the open groove project (m2e workspace
		     resolution) and a command-line build finds the installed artifact.
		     Update both when bumping the version (release checklist); scripts may
		     override with -Drevision. -->
		<revision>7.5.4-SNAPSHOT</revision>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<yfiles.version>3.6.0.1</yfiles.version>
		<junit.version>5.14.4</junit.version>
		<!-- directory holding the yFiles runtime license file, which the library
		     loads from the root of the class path; set it in your settings.xml or
		     with -D. The file never enters the repository. -->
		<yfiles.license.dir>${user.home}/yfiles-license</yfiles.license.dir>
		<!-- A command-line build first installs the GROOVE artifact from the
		     repository root, so that this backend is never compiled or tested
		     against a stale core. Pass -Dgroove.install.skip=true to skip that
		     (e.g. when the artifact was just installed). Eclipse skips it always
		     and compiles against the open groove project instead. -->
		<groove.install.skip>false</groove.install.skip>
	</properties>

	<name>${project.groupId}:${project.artifactId}</name>
	<description>
		GROOVE: yFiles graph-visualisation backend (optional, licensed).
	</description>

	<dependencies>
		<dependency>
			<groupId>nl.utwente.groove</groupId>
			<artifactId>groove</artifactId>
			<version>${revision}</version>
		</dependency>
		<dependency>
			<!-- installed locally from the licensed distribution, see README.md -->
			<groupId>com.yworks.yfiles</groupId>
			<artifactId>yfiles-for-java-swing</artifactId>
			<version>${yfiles.version}</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<!-- the freshness guard: install the GROOVE artifact from the
						     repository root before anything of this project is compiled -->
						<id>install-groove</id>
						<phase>initialize</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>${groove.install.skip}</skip>
							<executable>mvn</executable>
							<workingDirectory>${project.basedir}/..</workingDirectory>
							<arguments>
								<argument>-q</argument>
								<argument>install</argument>
								<argument>-DskipTests</argument>
								<argument>-Dmaven.javadoc.skip=true</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<!-- tells m2e to leave the freshness guard alone: in Eclipse the
					     groove project itself is on the build path -->
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.codehaus.mojo</groupId>
										<artifactId>exec-maven-plugin</artifactId>
										<versionRange>[3.0.0,)</versionRange>
										<goals>
											<goal>exec</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore />
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<!-- the license file is copied to the root of the class path;
				     a missing directory is silently skipped -->
				<directory>${yfiles.license.dir}</directory>
				<includes>
					<include>*.xml</include>
				</includes>
			</resource>
		</resources>
	</build>
</project>
