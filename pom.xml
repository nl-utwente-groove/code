<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.utwente.groove</groupId>
	<artifactId>groove</artifactId>
	<version>${revision}</version>
	
	<properties>
		<!-- the single source of truth for the GROOVE version number: the
		     GROOVE_VERSION resource read by util.Version is generated from
		     this property by resource filtering (see the resources section) -->
		<revision>7.5.4-SNAPSHOT</revision>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<junit.version>5.14.4</junit.version>
		<!-- Test categories excluded from the default test run;
		     override with -Dexcluded.test.groups= to run all tests
		     (GUI tests additionally skip themselves when headless) -->
		<excluded.test.groups>nl.utwente.groove.test.SlowTest,nl.utwente.groove.test.GuiTest</excluded.test.groups>
	</properties>

	<name>${project.groupId}:${project.artifactId}</name>
	<description>
		GROOVE: GUI, command-line tools and library for graph transformation and verification.
  	</description>
	<url>https://sf.net/projects/groove</url>
	<licenses>
		<license>
    		<name>The Apache License, Version 2.0</name>
	    	<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>
	
	<developers>
	    <developer>
    		<name>Arend Rensink</name>
			<email>arend.rensink@utwente.nl</email>
			<organization>University of Twente, The Netherlands</organization>
			<organizationUrl>http://people.utwente.nl/arend.rensink</organizationUrl>
		</developer>
	</developers>
	
	<scm>
	    <connection>scm:git:https://github.com/nl-utwente-groove/code.git</connection>
	    <developerConnection>scm:git:https://github.com/nl-utwente-groove/code.git</developerConnection>
	    <url>https://github.com/nl-utwente-groove/code.git</url>
	</scm>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
			</plugin>

			<plugin>
				<!-- Generates CtrlLexer, CtrlParser and CtrlChecker in
				     nl.utwente.groove.control.parse from the ANTLR 3 grammars
				     Ctrl.g and CtrlChecker.g (in src/main/antlr3) at build time -->
				<groupId>org.antlr</groupId>
				<artifactId>antlr3-maven-plugin</artifactId>
				<version>3.5.2</version>
				<configuration>
					<!-- makes the Ctrl.tokens vocabulary generated from Ctrl.g
					     findable when the tree grammar CtrlChecker.g is built -->
					<libDirectory>${project.build.directory}/generated-sources/antlr3/nl/utwente/groove/control/parse</libDirectory>
				</configuration>
				<executions>
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<goals>
							<goal>antlr</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.12.1</version>
				<configuration>
					<release>21</release>
	                <parameters>true</parameters>
                    <compilerArgs>
			            <arg>-Xlint:unchecked</arg>
			            <!-- module-info deliberately has requires transitive
			                 directives on automatic modules (their types occur
			                 in the exported API); the warning flags the risk
			                 that those module names change if the libraries
			                 ever adopt real module descriptors -->
			            <arg>-Xlint:-requires-transitive-automatic</arg>
		            </compilerArgs>
					<showWarnings>true</showWarnings>
					<showDeprecation>true</showDeprecation>
				</configuration>

				<dependencies>
					<dependency>
						<groupId>org.codehaus.plexus</groupId>
						<artifactId>plexus-compiler-eclipse</artifactId>
						<version>2.12.1</version>
					</dependency>

					<dependency>
						<groupId>org.eclipse.jdt</groupId>
						<artifactId>ecj</artifactId>
						<version>3.31.0</version>
					</dependency>
				</dependencies>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<additionalOptions>-Xdoclint:none</additionalOptions>
					<reportOutputDirectory>target</reportOutputDirectory>
				</configuration>
				<executions>
        			<execution>
		        		<id>attach-javadocs</id>
        		  		<goals>
		            		<goal>jar</goal>
        		  		</goals>
		        	</execution>
      			</executions>
			</plugin>
			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<excludedGroups>${excluded.test.groups}</excludedGroups>
					<!-- Keep all tests out of the real user preference store:
					     the in-memory preferences factory replaces the platform
					     one for the whole test JVM. Surefire patches the tests
					     into module nl.utwente.groove, so java.prefs needs the
					     add-exports to instantiate the factory reflectively. -->
					<argLine>-Djava.util.prefs.PreferencesFactory=nl.utwente.groove.test.gui.InMemoryPreferencesFactory --add-exports=nl.utwente.groove/nl.utwente.groove.test.gui=java.prefs</argLine>
					<excludes>
						<!-- TestSuite aggregates the whole package tree as the
						     entry point of the "GROOVE - all JUnit tests"
						     launch; Surefire discovers the test classes
						     directly, so running the suite as well would
						     execute every test twice. -->
						<exclude>**/TestSuite.java</exclude>
					</excludes>
				</configuration>
			</plugin>

		</plugins>

		<resources>
			<resource>
				<!-- packages Ctrl.g as a resource, read at runtime by CtrlDoc -->
				<directory>src/main/antlr3/nl/utwente/groove/control/parse</directory>
				<includes>
					<include>Ctrl.g</include>
				</includes>
				<targetPath>nl/utwente/groove/resource/antlr</targetPath>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>nl/utwente/groove/resource/version/GROOVE_VERSION</exclude>
				</excludes>
			</resource>
			<resource>
				<!-- GROOVE_VERSION contains ${revision}, so that the pom is
				     the single source of truth for the version number; only
				     this one file is filtered, since filtering would corrupt
				     binary resources and substitute stray ${...} tokens
				     elsewhere -->
				<directory>src/main/resources</directory>
				<includes>
					<include>nl/utwente/groove/resource/version/GROOVE_VERSION</include>
				</includes>
				<filtering>true</filtering>
			</resource>
		</resources>
	</build>

    <profiles>
    	<profile>
    		<id>maven</id>
	<build>
		<plugins>
	        <plugin>
    	        <groupId>org.sonatype.central</groupId>
        	    <artifactId>central-publishing-maven-plugin</artifactId>
	            <version>0.9.0</version>
    	        <extensions>true</extensions>
        	    <configuration>
            	    <publishingServerId>central</publishingServerId>
        	        <autoPublish>true</autoPublish>
	            </configuration>
    	    </plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.0.1</version>
				<configuration>
					<autoVersionSubmodules>true</autoVersionSubmodules>
				    <useReleaseProfile>false</useReleaseProfile>
				    <releaseProfiles>release</releaseProfiles>
				    <goals>deploy</goals>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-gpg-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
				    <execution>
					   	<id>verify-sign-artifacts</id>
				       	<phase>verify</phase>
				    	<goals>
	    	        		<goal>sign</goal>
    	    			</goals>
			        </execution>
				</executions>
				<configuration>
					<gpgArguments>
                    	<arg>--pinentry-mode</arg>
                    	<arg>loopback</arg>
                	</gpgArguments>
				</configuration>
			</plugin>
			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>2.2.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
    	</profile>
    </profiles>
	<dependencies>
		<dependency>
			<groupId>com.opencsv</groupId>
			<artifactId>opencsv</artifactId>
			<version>5.12.0</version>
		</dependency>
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>3.0.1</version>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-core</artifactId>
			<version>3.0.2</version>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>3.0.2</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf</artifactId>
			<version>3.7.2</version>
		</dependency>
		<dependency>
			<groupId>jgraph</groupId>
			<artifactId>jgraph</artifactId>
			<version>5.13.0.0</version>
		</dependency>
		<dependency>
			<groupId>info.picocli</groupId>
			<artifactId>picocli</artifactId>
			<version>4.7.7</version>
		</dependency>
		<dependency>
			<groupId>org.apache.groovy</groupId>
			<artifactId>groovy</artifactId>
			<version>5.0.7</version>
		</dependency>
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>rsyntaxtextarea</artifactId>
			<version>3.6.3</version>
		</dependency>
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr-complete</artifactId>
			<version>3.5.2</version>
			<exclusions>
				<exclusion>
					<groupId>org.antlr</groupId>
					<artifactId>antlr-runtime</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.antlr</groupId>
					<artifactId>antlr</artifactId>
				</exclusion>
				<exclusion>
					<groupId>junit</groupId>
					<artifactId>junit</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlrworks</artifactId>
			<version>1.5.2</version>
			<exclusions>
				<exclusion>
					<groupId>org.antlr</groupId>
					<artifactId>antlr-runtime</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.antlr</groupId>
					<artifactId>antlr</artifactId>
				</exclusion>
				<exclusion>
					<!-- antlr 2.7.7, pulled in via stringtemplate; shares package
					     antlr.debug with antlr-complete, a split package that
					     fails module resolution if both land on the module path -->
					<groupId>antlr</groupId>
					<artifactId>antlr</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jdt</groupId>
			<artifactId>org.eclipse.jdt.annotation</artifactId>
			<version>2.2.700</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore</artifactId>
			<version>2.41.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.common</artifactId>
			<version>2.41.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore.xmi</artifactId>
			<version>2.39.0</version>
		</dependency>
		<dependency>
    		<groupId>org.apache.xmlgraphics</groupId>
    		<artifactId>batik-all</artifactId>
    		<version>1.17</version>
    		<exclusions>
				<exclusion>
				    <groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
    		<groupId>org.apache.xmlgraphics</groupId>
		    <artifactId>fop-core</artifactId>
    		<version>2.9</version>
    		<exclusions>
				<exclusion>
				    <groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
				<exclusion>
				    <groupId>org.apache.xmlgraphics</groupId>
					<artifactId>batik-svggen</artifactId>
				</exclusion>
				<exclusion>
				    <groupId>org.apache.xmlgraphics</groupId>
					<artifactId>batik-dom</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Third-party libraries republished to Maven Central under the
		     GROOVE namespace; built and maintained in lib/publish -->
		<dependency>
			<groupId>nl.utwente.groove</groupId>
			<artifactId>gnuprologjava</artifactId>
			<version>0.2.6.1</version>
		</dependency>
		<dependency>
			<groupId>nl.utwente.groove</groupId>
			<artifactId>ltl2buchi</artifactId>
			<version>2010.12.1</version>
		</dependency>
		<dependency>
			<groupId>nl.utwente.groove</groupId>
			<artifactId>osxadapter</artifactId>
			<version>2.0.1</version>
		</dependency>
		<dependency>
			<groupId>nl.utwente.groove</groupId>
			<artifactId>groove-gxl</artifactId>
			<version>3.0.1</version>
		</dependency>

		<!-- Test libraries -->
		<dependency>
			<!-- Jemmy 2 Swing UI test library, as republished (verbatim, from
			     the 2012 upstream build) by every Apache NetBeans release;
			     drives the Simulator in the GUI smoke tests (GuiTest category).
			     License CDDL-1.0, verified via the Apache NetBeans attribution
			     file harness/jemmy/external/jemmy-2.3.1.1-license.txt:
			     acceptable as a test-scope (never distributed) dependency. -->
			<groupId>org.netbeans.external</groupId>
			<artifactId>jemmy-2.3.1.1</artifactId>
			<version>RELEASE300</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.vintage</groupId>
			<artifactId>junit-vintage-engine</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Supplies the suite API and engine for TestSuite. Do not replace this
		     with the deprecated junit-platform-runner: its presence makes
		     Surefire auto-detect the JUnit 4 provider, which silently skips
		     all JUnit 5 (Jupiter) test classes. -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-suite</artifactId>
			<version>1.14.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>