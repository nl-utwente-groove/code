<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
	<id>zip</id>
	<formats>
		<format>zip</format>
	</formats>
	<fileSets>
	    <fileSet>
		    <directory>../../yfiles/include</directory>
			<outputDirectory></outputDirectory>
	    </fileSet>
	    <fileSet>
		    <directory>../../yfiles/target/lib</directory>
			<outputDirectory>lib</outputDirectory>
	    </fileSet>
	    <fileSet>
		    <directory>../../include</directory>
			<outputDirectory></outputDirectory>
	    </fileSet>
	    <fileSet>
		    <directory>../../runnable/target</directory>
			<outputDirectory>bin</outputDirectory>
	    </fileSet>
	</fileSets>
	
	<dependencySets>
		<dependencySet>
			<includes>
				<!-- the artifact type belongs in the pattern: the filter matches
				     leniently, as a substring, and (with transitive filtering) also
				     against every entry of an artifact's dependency trail, which
				     starts with the assembling module itself
				     (nl.utwente.groove:groove-bin:pom:1.0). Plain
				     "nl.utwente.groove:groove" is a substring of that, so it lets
				     through every dependency of the module, including the pom-typed
				     ones that only order the reactor -->
				<include>nl.utwente.groove:groove:jar</include>
			</includes>
			<useTransitiveFiltering>true</useTransitiveFiltering>
			<outputDirectory>lib</outputDirectory>
			<useProjectArtifact>false</useProjectArtifact>
		</dependencySet>
	</dependencySets>
	
	<baseDirectory>${zip.basedir}</baseDirectory>
</assembly>