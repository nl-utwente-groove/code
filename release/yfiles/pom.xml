<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>nl.utwente.groove</groupId>
		<artifactId>release</artifactId>
		<version>1.0</version>
	</parent>
	<artifactId>yfiles-obfuscated</artifactId>
	<packaging>pom</packaging>

	<!-- The obfuscated yFiles jars (built only under the yfiles profile of the
	     parent): the yFiles backend and the yFiles library in the form in which
	     they may be distributed. The yFiles license allows redistributing the
	     library only in obfuscated form, and yWorks require the same of the code
	     that calls it, so this module runs yWorks' free yGuard obfuscator over
	     the library jar together with the groove-yfiles jar: every name under
	     com.yworks is renamed (including the library's resource bundles), and so
	     are the backend's own classes and members, with all references between
	     the two rewritten. Nothing outside the backend jar names its classes:
	     the GROOVE core finds the backend through the ServiceLoader, whose
	     provider file in the jar is rewritten along with the class it names.
	     Only what the backend overrides or implements of the GROOVE core and
	     the JDK keeps its name, which yGuard works out from the external class
	     path. This is the setup of the deployment demo in the yFiles
	     distribution and of the "Obfuscation" appendix of its developer guide,
	     extended to the calling code. The two resulting jars land in target/lib
	     under their original file names, and target/yguard.log.xml.gz records
	     the name mapping (readable with java -jar yguard.jar [log]); it undoes
	     the obfuscation and must never be published (see release/README.md).
	     The plain library jar never leaves the local Maven repository. -->

	<properties>
		<!-- yfiles.version and the names of the two jars are properties of the
		     parent, since the yFiles zip checks them as well -->
		<yguard.version>4.1.1</yguard.version>
	</properties>

	<dependencies>
		<dependency>
			<!-- the backend with, transitively, the library and the GROOVE core:
			     the class path against which yGuard resolves external names -->
			<groupId>${project.groupId}</groupId>
			<artifactId>groove-yfiles</artifactId>
			<version>${revision}</version>
		</dependency>
		<dependency>
			<!-- referenced by the library's class files (annotations, absent at run
			     time); on the external class path only to keep yGuard's warnings
			     about unresolved names meaningful -->
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>3.0.2</version>
		</dependency>
		<dependency>
			<!-- the launcher jars below are made from those of the runnable
			     modules, as in the assembly modules. The dependency puts this
			     module after the runnable aggregator only, which itself precedes
			     its modules; what puts it after them is the order of the modules
			     in the parent, profile modules coming last. Excluded from the
			     external class path -->
			<groupId>${project.groupId}</groupId>
			<artifactId>runnable</artifactId>
			<version>${project.version}</version>
			<type>pom</type>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<!-- the two jars to obfuscate, under their repository names -->
						<id>copy-inputs</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/in</outputDirectory>
							<artifactItems>
								<artifactItem>
									<groupId>${project.groupId}</groupId>
									<artifactId>groove-yfiles</artifactId>
									<version>${revision}</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.yworks.yfiles</groupId>
									<artifactId>yfiles-for-java-swing</artifactId>
									<version>${yfiles.version}</version>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
					<execution>
						<!-- everything the two jars reference but that is not itself
						     obfuscated: the GROOVE core and its dependencies -->
						<id>external-classpath</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>build-classpath</goal>
						</goals>
						<configuration>
							<excludeArtifactIds>groove-yfiles,yfiles-for-java-swing,runnable</excludeArtifactIds>
							<outputProperty>external.classpath</outputProperty>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<dependencies>
					<dependency>
						<groupId>com.yworks</groupId>
						<artifactId>yguard</artifactId>
						<version>${yguard.version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>obfuscate</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<taskdef name="yguard" classname="com.yworks.yguard.YGuardTask" classpathref="maven.plugin.classpath" />
								<mkdir dir="${project.build.directory}/lib" />
								<yguard>
									<inoutpair in="${project.build.directory}/in/${yfiles.jar}" out="${project.build.directory}/lib/${yfiles.jar}" />
									<inoutpair in="${project.build.directory}/in/${backend.jar}" out="${project.build.directory}/lib/${backend.jar}" />
									<externalclasses path="${external.classpath}" />
									<rename logfile="${project.build.directory}/yguard.log.xml.gz" replaceClassNameStrings="true" annotationclass="com.yworks.yfiles.utils.Obfuscation">
										<keep>
											<!-- No name of the backend is kept. Its line numbers
											     are, so that a stack trace through it can be
											     translated back with the name mapping; the JDK
											     prints them only for a class that names a source
											     file, hence the constant one (the real name would
											     give away the class) -->
											<sourcefile>
												<property name="mapping" value="y" />
												<patternset>
													<include name="nl.utwente.groove.**" />
												</patternset>
											</sourcefile>
											<linenumbertable>
												<patternset>
													<include name="nl.utwente.groove.**" />
												</patternset>
											</linenumbertable>
										</keep>
										<!-- the library's resource bundles are named after their
										     classes and must follow them -->
										<adjust replaceName="true">
											<include name="**/*.properties" />
										</adjust>
										<!-- the provider file by which the ServiceLoader of the
										     GROOVE core finds the backend names the provider
										     class, which is renamed; the file itself is named
										     after an interface of the core and keeps its name -->
										<adjust replaceContentPolicy="strict" replaceContentSeparator=".">
											<include name="META-INF/services/*" />
										</adjust>
									</rename>
								</yguard>
							</target>
						</configuration>
					</execution>
					<execution>
						<!-- The launcher jars of the yFiles zip, in target/bin: those of
						     the runnable modules, whose manifest Class-Path lists the
						     jars of lib/ that the GROOVE core needs, with the two
						     obfuscated jars added to it. They are made here rather than
						     by switching the runnable modules under the profile, so that
						     the plain launcher jars, and with them the plain zips, are
						     the same whether or not the profile is active. Ant merges
						     the manifest of the source jar with the nested one into a
						     single Class-Path attribute and keeps the other attributes
						     (Main-Class, Enable-Native-Access) as they are. -->
						<id>launchers</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<macrodef name="launcher">
									<attribute name="name" />
									<sequential>
										<jar destfile="${project.build.directory}/bin/@{name}.jar" filesetmanifest="merge" mergeClassPathAttributes="true" flattenAttributes="true">
											<zipfileset src="${project.basedir}/../runnable/target/@{name}.jar" />
											<manifest>
												<attribute name="Class-Path" value="../lib/${backend.jar} ../lib/${yfiles.jar}" />
											</manifest>
										</jar>
									</sequential>
								</macrodef>
								<delete dir="${project.build.directory}/bin" />
								<launcher name="Simulator" />
								<launcher name="Generator" />
								<launcher name="ModelChecker" />
								<launcher name="Imager" />
								<launcher name="Viewer" />
							</target>
						</configuration>
					</execution>
					<execution>
						<!-- Release guard. The backend jar carries a yFiles licence
						     at its class-path root, selected by yfiles.license.file
						     in the backend pom and copied through unchanged by
						     yGuard; it is what licenses the obfuscated library at
						     run time. That property defaults to the distribution
						     licence but is meant to be overridable, for a
						     development build with the development watermark, and
						     the development licence says
						     <distribution>false</distribution>: the SLA does not
						     allow it to be redistributed, so packaging one publishes
						     it to everyone who downloads the zip. That is what
						     reached the public 99.0.x test releases between
						     2026-09-14 and 2026-09-21, when the backend build still
						     packaged every .xml in the licence directory. The check
						     therefore inspects what is about to be distributed, the
						     obfuscated jars in target/lib, rather than trusting the
						     property, and fails the build. A distribution licence, saying true,
						     passes; so does a jar with no licence at all, that being
						     a run-time defect rather than a licence breach. -->
						<id>check-license</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<!-- extracted afresh, so that a stale extraction can
								     neither mask nor fake a finding -->
								<delete dir="${project.build.directory}/license-check" />
								<unzip dest="${project.build.directory}/license-check">
									<fileset dir="${project.build.directory}/lib" includes="*.jar" />
									<patternset>
										<include name="*.xml" />
									</patternset>
								</unzip>
								<fileset id="nondistributable" dir="${project.build.directory}/license-check" erroronmissingdir="false">
									<include name="*.xml" />
									<containsregexp expression="&lt;distribution&gt;\s*false\s*&lt;/distribution&gt;" casesensitive="false" />
								</fileset>
								<pathconvert property="nondistributable.licenses" refid="nondistributable" pathsep="${line.separator}  " setonempty="false" />
								<fail if="nondistributable.licenses">

The obfuscated jars carry a yFiles licence marked &lt;distribution&gt;false&lt;/distribution&gt;,
which the yFiles SLA does not allow to be redistributed:

  ${nondistributable.licenses}

Only the distribution licence may be packaged. Rebuild the backend with
yfiles.license.file left at its default; see the "How to build the obfuscated
yFiles jars" section of release/README.md.
								</fail>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
