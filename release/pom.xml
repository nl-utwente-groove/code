<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.utwente.groove</groupId>
	<artifactId>release</artifactId>
	<version>1.0</version>
	<packaging>pom</packaging>

	<properties>
		<revision>0.0.0-SNAPSHOT</revision>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- the yFiles library and the names of the two obfuscated jars, used
		     by the yfiles module and the yFiles zip of the yfiles profile;
		     keep yfiles.version equal to that of yfiles/pom.xml -->
		<yfiles.version>3.6.0.1</yfiles.version>
		<yfiles.jar>yfiles-for-java-swing-${yfiles.version}.jar</yfiles.jar>
		<backend.jar>groove-yfiles-${revision}.jar</backend.jar>
	</properties>

	<modules>
		<module>runnable</module>
		<module>assembly</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.8.1</version>
				</plugin>
				<plugin>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<!-- the version with underscores, as used in the artifact names
				     (groove-x_y_z-bin.zip) -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.3.0</version>
				<executions>
					<execution>
						<id>regex-property</id>
						<goals>
							<goal>regex-property</goal>
						</goals>
						<configuration>
							<name>groove-version-underscored</name>
							<value>${revision}</value>
							<regex>\.</regex>
							<replacement>_</replacement>
							<failIfNoMatch>false</failIfNoMatch>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>groove</artifactId>
			<version>${revision}</version>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<!-- The obfuscated yFiles jars: the yFiles backend (the groove-yfiles
			     artifact built from the unit in yfiles/) and the yFiles library,
			     both obfuscated as the license of the library requires (see
			     README.md). The standard zips are not affected. Activate with
			     -Pyfiles; it needs the licensed library in the local Maven
			     repository. -->
			<id>yfiles</id>
			<modules>
				<module>yfiles</module>
			</modules>
		</profile>
	</profiles>
</project>