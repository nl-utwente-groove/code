  <!-- Spliced into jpackage's main.wxs by build-installer.sh, which also adds a
       reference to the property MSIRESTARTMANAGERCONTROL to the product. WiX 3
       syntax, like jpackage's own sources. -->
  <Fragment>
    <!-- Asks the user to close a running GROOVE before the installation touches
         anything: an upgrade, a repair or an uninstall of an installed GROOVE,
         which the condition of the rows requires, since the check matches process
         names only and a fresh installation should not trip over some other
         product's Viewer.exe. The rows are WiX's CloseApplication with nothing but
         the prompt: RebootPrompt is on by default and would, like the close and
         terminate options, make the immediate action schedule its deferred half,
         which is not allowed before InstallInitialize. With the prompt alone the
         action looks for the executable among the running processes and, if it
         is there, shows Windows Installer's Cancel/Retry/Ignore box with the
         description (Retry looks again, Cancel ends the installation with the
         installed version intact, Ignore continues regardless); it is rescheduled
         before RemoveExistingProducts, which jpackage puts before costing, so that
         the old version is still whole when the user cancels. A silent
         installation gets no box and continues.

         Windows Installer's own handling of files in use does not work for GROOVE.
         Its Restart Manager check, in InstallValidate, does find the processes
         exactly, but by default its dialog offers to close them, which fails:
         every launcher start is two processes, a windowless launcher and the JVM
         it starts as a child, the Restart Manager cannot close the launcher, and
         it would end the Simulator's session rather than close its window, most
         likely without a chance to ask about unsaved grammars. Disable falls back
         to the older FilesInUse dialog, whose check matches loaded DLLs by name:
         it takes minutes and lists every application that loads the same runtime
         DLLs as the bundled Java runtime (browsers, mail, IDEs), and Retry never
         clears. DisableShutdown, kept below for the Ignore case, only reports that
         a reboot will be required (twice in an upgrade, once from the old
         version's own removal) and then blocks silently on the class-path jars,
         which the JVM opens without delete sharing, so that they can neither be
         replaced nor moved aside until GROOVE exits; in a test the file copy then
         failed outright (error 1304) and rolled back, and since the old version
         had already been removed, no GROOVE was installed at all. -->
    <?define GrooveClosePrompt = "Save your work and close it, then click Retry (it takes a few seconds to exit). Ignore continues while GROOVE runs, which fails when GROOVE keeps its files open; Cancel changes nothing." ?>
    <?define GrooveCloseCondition = "Installed OR JP_UPGRADABLE_FOUND OR JP_DOWNGRADABLE_FOUND OR GROOVE_SAME_VERSION_FOUND" ?>
    <util:CloseApplication Id="GrooveCloseMain" Target="GROOVE.exe" Sequence="1"
        PromptToContinue="yes" RebootPrompt="no"
        Description="GROOVE is running. $(var.GrooveClosePrompt)">$(var.GrooveCloseCondition)</util:CloseApplication>
    <util:CloseApplication Id="GrooveCloseSimulator" Target="Simulator.exe" Sequence="2"
        PromptToContinue="yes" RebootPrompt="no"
        Description="The GROOVE Simulator is running. $(var.GrooveClosePrompt)">$(var.GrooveCloseCondition)</util:CloseApplication>
    <util:CloseApplication Id="GrooveCloseGenerator" Target="Generator.exe" Sequence="3"
        PromptToContinue="yes" RebootPrompt="no"
        Description="The GROOVE Generator is running. $(var.GrooveClosePrompt)">$(var.GrooveCloseCondition)</util:CloseApplication>
    <util:CloseApplication Id="GrooveCloseModelChecker" Target="ModelChecker.exe" Sequence="4"
        PromptToContinue="yes" RebootPrompt="no"
        Description="The GROOVE ModelChecker is running. $(var.GrooveClosePrompt)">$(var.GrooveCloseCondition)</util:CloseApplication>
    <util:CloseApplication Id="GrooveCloseImager" Target="Imager.exe" Sequence="5"
        PromptToContinue="yes" RebootPrompt="no"
        Description="The GROOVE Imager is running. $(var.GrooveClosePrompt)">$(var.GrooveCloseCondition)</util:CloseApplication>
    <util:CloseApplication Id="GrooveCloseViewer" Target="Viewer.exe" Sequence="6"
        PromptToContinue="yes" RebootPrompt="no"
        Description="The GROOVE Viewer is running. $(var.GrooveClosePrompt)">$(var.GrooveCloseCondition)</util:CloseApplication>
    <InstallExecuteSequence>
      <Custom Action="WixCloseApplications" Before="RemoveExistingProducts"/>
    </InstallExecuteSequence>
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown"/>
  </Fragment>
