  <!-- Spliced into jpackage's main.wxs by build-installer.sh, which also adds a
       reference to the UI GrooveReplaceWarningUI next to jpackage's own JpUI, and
       gives every build its own product code (see below). WiX 3 syntax, like
       jpackage's own sources. -->
  <Fragment>
    <!-- Detects an installed build of the same version. jpackage derives the product
         code from name and version, so a rebuild of the same version would be taken
         for a minor update of the installed product, which msiexec refuses with
         error 1638 ("Another version of this product is already installed"), and
         jpackage's upgrade rules exclude the same version anyway. With a product
         code of its own per build, this rule finds the other build, and
         RemoveExistingProducts removes it like an older version. It has its own
         property because jpackage's JpFindRelatedProducts resets JP_UPGRADABLE_FOUND
         and JP_DOWNGRADABLE_FOUND. Running the very same file again still opens the
         maintenance dialog (repair or remove). -->
    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion Property="GROOVE_SAME_VERSION_FOUND" MigrateFeatures="yes"
                      Minimum="$(var.JpAppVersion)" IncludeMinimum="yes"
                      Maximum="$(var.JpAppVersion)" IncludeMaximum="yes"/>
    </Upgrade>
    <!-- The version of GROOVE that an installation replaces, read from the
         uninstall entry of its product code (see below), which Windows Installer
         keeps under HKLM even for this per-user installation; HKCU is searched
         as well in case it does not. FindRelatedProducts and jpackage's
         JpFindRelatedProducts run before AppSearch, so the product codes are
         known when the key paths are formatted. -->
    <Property Id="GROOVE_OLDER_VERSION">
      <RegistrySearch Id="GrooveOlderVersionHklm" Root="HKLM" Type="raw" Win64="yes"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[JP_UPGRADABLE_FOUND]" Name="DisplayVersion"/>
      <RegistrySearch Id="GrooveOlderVersionHkcu" Root="HKCU" Type="raw" Win64="yes"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[JP_UPGRADABLE_FOUND]" Name="DisplayVersion"/>
    </Property>
    <Property Id="GROOVE_NEWER_VERSION">
      <RegistrySearch Id="GrooveNewerVersionHklm" Root="HKLM" Type="raw" Win64="yes"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[JP_DOWNGRADABLE_FOUND]" Name="DisplayVersion"/>
      <RegistrySearch Id="GrooveNewerVersionHkcu" Root="HKCU" Type="raw" Win64="yes"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[JP_DOWNGRADABLE_FOUND]" Name="DisplayVersion"/>
    </Property>
    <!-- Warns before an installation replaces another version of GROOVE. jpackage
         defines both JpAllowUpgrades and JpAllowDowngrades, so its main.wxs removes
         any other version with the same upgrade code, older or newer, without
         saying so. Its JpFindRelatedProducts also runs in the UI sequence and sets
         JP_UPGRADABLE_FOUND (an older version) or JP_DOWNGRADABLE_FOUND (a newer
         one), and the rule above sets GROOVE_SAME_VERSION_FOUND (another build of
         this version); this page is shown before the licence page if any of them is
         set, and says which, with the version if the search above found it.
         Continue proceeds to the licence page, Cancel asks WiX's usual confirmation
         and leaves the installed version alone. Whether the yFiles add-on is
         present is not checked, hence the "if installed". A silent installation
         (msiexec /qn) shows no dialog and replaces the other version as before. -->
    <UI Id="GrooveReplaceWarningUI">
      <Dialog Id="GrooveReplaceDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Continue" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="&amp;Continue">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="290" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}GROOVE is already installed"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="This installation replaces the installed version."/>
        <Control Id="Older" Type="Text" X="20" Y="60" Width="330" Height="30"
                 Hidden="yes" NoPrefix="yes"
                 Text="An older version, GROOVE [GROOVE_OLDER_VERSION], is currently installed. Continuing replaces it with GROOVE [ProductVersion].">
          <Condition Action="show">JP_UPGRADABLE_FOUND AND GROOVE_OLDER_VERSION</Condition>
        </Control>
        <Control Id="OlderUnknown" Type="Text" X="20" Y="60" Width="330" Height="30"
                 Hidden="yes" NoPrefix="yes"
                 Text="An older version is currently installed. Continuing replaces it with GROOVE [ProductVersion].">
          <Condition Action="show">JP_UPGRADABLE_FOUND AND NOT GROOVE_OLDER_VERSION</Condition>
        </Control>
        <Control Id="Newer" Type="Text" X="20" Y="60" Width="330" Height="30"
                 Hidden="yes" NoPrefix="yes"
                 Text="A newer version, GROOVE [GROOVE_NEWER_VERSION], is currently installed. Continuing replaces it with the older GROOVE [ProductVersion].">
          <Condition Action="show">JP_DOWNGRADABLE_FOUND AND NOT JP_UPGRADABLE_FOUND AND GROOVE_NEWER_VERSION</Condition>
        </Control>
        <Control Id="NewerUnknown" Type="Text" X="20" Y="60" Width="330" Height="30"
                 Hidden="yes" NoPrefix="yes"
                 Text="A newer version is currently installed. Continuing replaces it with the older GROOVE [ProductVersion].">
          <Condition Action="show">JP_DOWNGRADABLE_FOUND AND NOT JP_UPGRADABLE_FOUND AND NOT GROOVE_NEWER_VERSION</Condition>
        </Control>
        <Control Id="Same" Type="Text" X="20" Y="60" Width="330" Height="30"
                 Hidden="yes" NoPrefix="yes"
                 Text="This version, GROOVE [ProductVersion], is already installed from a different build. Continuing replaces it with this build.">
          <Condition Action="show">GROOVE_SAME_VERSION_FOUND AND NOT JP_UPGRADABLE_FOUND AND NOT JP_DOWNGRADABLE_FOUND</Condition>
        </Control>
        <Control Id="Kept" Type="Text" X="20" Y="100" Width="330" Height="30" NoPrefix="yes"
                 Text="Your grammars and preferences are not affected. If installed, the yFiles add-on is removed and offered again at the first start of the Simulator."/>
        <Control Id="Choice" Type="Text" X="20" Y="140" Width="330" Height="30" NoPrefix="yes"
                 Text="Click Continue to proceed, or Cancel to keep the installed version."/>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="GrooveReplaceDlg" Before="WelcomeEulaDlg">NOT Installed AND (JP_UPGRADABLE_FOUND OR JP_DOWNGRADABLE_FOUND OR GROOVE_SAME_VERSION_FOUND)</Show>
      </InstallUISequence>
    </UI>
  </Fragment>
