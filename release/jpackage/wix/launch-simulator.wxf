  <!-- Spliced into jpackage's main.wxs by build-installer.sh, which also adds a
       reference to the UI GrooveLaunchSimulatorUI next to jpackage's own JpUI.
       WiX 3 syntax, like jpackage's own sources. -->
  <Fragment>
    <!-- Offers to start the Simulator on the last page of the installation, through
         the optional checkbox of WiX's standard ExitDialog, on which every WixUI
         dialog set ends. The checkbox is ticked by default. ExitDialog shows it
         only after an installation (NOT Installed), an upgrade included, and not
         after a repair or an uninstall, which end on the same dialog; the launch
         carries the same condition. The launch goes through WixShellExec from
         WixUtilExtension, which jpackage links anyway; a plain exe custom action
         (Directory plus ExeCommand) fails when run from ExitDialog, with return
         value 1631. The Simulator starts as the installing user, who for this
         per-user installation is not elevated. A silent installation shows no
         dialog and launches nothing. -->
    <UI Id="GrooveLaunchSimulatorUI">
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start the GROOVE Simulator"/>
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
      <Property Id="WixShellExecTarget" Value="[INSTALLDIR]Simulator.exe"/>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="GrooveLaunchSimulator">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>
    <CustomAction Id="GrooveLaunchSimulator" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes"/>
    <!-- Windows Installer paints checkboxes in the system dialog colour and cannot
         make them transparent, so on WiX's white dialog background the checkbox
         shows up as a gray block (so does the licence checkbox on the first
         page). The replacement background of the first and last pages is dialog
         gray wherever the dialogs place their controls, with a tinted GROOVE
         panel to the left of them; the banner of the pages in between (progress,
         files in use, maintenance) gets the same tint and the G in place of
         WiX's icon. build-installer.sh substitutes the placeholder with the
         icons directory. -->
    <WixVariable Id="WixUIDialogBmp" Value="@GROOVE_ICONS_DIR@/groove-dialog.bmp"/>
    <WixVariable Id="WixUIBannerBmp" Value="@GROOVE_ICONS_DIR@/groove-banner.bmp"/>
  </Fragment>
