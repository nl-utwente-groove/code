<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.utwente.groove</groupId>
	<artifactId>osxadapter</artifactId>
	<version>2.0.1</version>
	<packaging>jar</packaging>

	<name>OSXAdapter (GROOVE repackaging)</name>
	<description>
	Repackaging of Apple's OSXAdapter 2.0 sample code, which hooks Java
	application preferences/about/quit functionality into the Mac OS X
	application menu via reflection, published on Maven Central for use by
	GROOVE (https://nl-utwente-groove.github.io). The class files are identical
	to the upstream 2.0 release; this repackaging only adds an
	Automatic-Module-Name manifest entry and the license text.
	</description>
	<url>https://github.com/nl-utwente-groove/code</url>

	<licenses>
		<license>
			<name>Apple Sample Code License</name>
			<url>https://github.com/nl-utwente-groove/code/blob/master/lib/publish/osxadapter/src/main/resources/META-INF/LICENSE.txt</url>
			<comments>Apple's sample-code license, permitting use, reproduction,
			modification and redistribution; see META-INF/LICENSE.txt inside
			the jar.</comments>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Arend Rensink</name>
			<email>arend.rensink@utwente.nl</email>
			<organization>University of Twente, The Netherlands</organization>
			<roles>
				<role>packager (upstream code by Apple Inc.)</role>
			</roles>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/nl-utwente-groove/code.git</connection>
		<developerConnection>scm:git:https://github.com/nl-utwente-groove/code.git</developerConnection>
		<url>https://github.com/nl-utwente-groove/code.git</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<upstream.version>2.0</upstream.version>
		<upstream.dir>${project.basedir}/../../repo/nl/utwente/groove/${project.artifactId}/${upstream.version}</upstream.dir>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<!-- unpacks the upstream binary jar; the manifest is
						     regenerated by maven-jar-plugin below -->
						<id>unpack-upstream</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<unzip src="${upstream.dir}/${project.artifactId}-${upstream.version}.jar" dest="${project.build.outputDirectory}">
									<patternset>
										<exclude name="META-INF/MANIFEST.MF"/>
									</patternset>
								</unzip>
							</target>
						</configuration>
					</execution>
					<execution>
						<!-- Maven Central requires a javadoc jar to be present;
						     no javadoc exists for this legacy binary artifact,
						     so a stub explaining that is packaged instead -->
						<id>javadoc-stub</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<jar destfile="${project.build.directory}/${project.build.finalName}-javadoc.jar" basedir="${project.basedir}/src/javadoc"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<archive>
						<manifestEntries>
							<!-- stabilizes the module name that GROOVE's
							     module-info requires; must never change -->
							<Automatic-Module-Name>osxadapter</Automatic-Module-Name>
							<Specification-Title>OSXAdapter</Specification-Title>
							<Specification-Version>${upstream.version}</Specification-Version>
							<Implementation-Title>OSXAdapter</Implementation-Title>
							<Implementation-Version>${upstream.version}</Implementation-Version>
							<Implementation-Vendor>Apple Inc.</Implementation-Vendor>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>attach-sources-and-javadoc</id>
						<phase>package</phase>
						<goals>
							<goal>attach-artifact</goal>
						</goals>
						<configuration>
							<artifacts>
								<artifact>
									<file>${upstream.dir}/${project.artifactId}-${upstream.version}-sources.jar</file>
									<type>jar</type>
									<classifier>sources</classifier>
								</artifact>
								<artifact>
									<file>${project.build.directory}/${project.build.finalName}-javadoc.jar</file>
									<type>jar</type>
									<classifier>javadoc</classifier>
								</artifact>
							</artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>maven</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.9.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- deliberately not auto-published: validate the
							     bundle in the Central portal before releasing;
							     Central publications are irrevocable -->
							<autoPublish>false</autoPublish>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>verify-sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
