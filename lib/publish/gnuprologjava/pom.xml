<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.utwente.groove</groupId>
	<artifactId>gnuprologjava</artifactId>
	<version>0.2.6.1</version>
	<packaging>jar</packaging>

	<name>GNU Prolog for Java (GROOVE repackaging)</name>
	<description>
	Repackaging of GNU Prolog for Java 0.2.6, an ISO Prolog interpreter library,
	published on Maven Central for use by GROOVE (https://nl-utwente-groove.github.io).
	The class files are identical to the upstream 0.2.6 release; this repackaging
	only adds an Automatic-Module-Name manifest entry and the license texts.
	Includes the gnu.getopt package (LGPL 2.0, see gnu/getopt/COPYING.LIB inside
	the jar).
	</description>
	<url>https://www.gnu.org/software/gnuprologjava/</url>

	<licenses>
		<license>
			<name>GNU Lesser General Public License, Version 3</name>
			<url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
			<comments>License of the gnu.prolog code; the embedded gnu.getopt
			package is under LGPL 2.0. The license texts are included in the
			jar under META-INF.</comments>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Arend Rensink</name>
			<email>arend.rensink@utwente.nl</email>
			<organization>University of Twente, The Netherlands</organization>
			<roles>
				<role>packager (upstream code by the GNU Prolog for Java project)</role>
			</roles>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/nl-utwente-groove/code.git</connection>
		<developerConnection>scm:git:https://github.com/nl-utwente-groove/code.git</developerConnection>
		<url>https://github.com/nl-utwente-groove/code.git</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<upstream.version>0.2.6</upstream.version>
		<upstream.dir>${project.basedir}/../upstream</upstream.dir>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<!-- unpacks the upstream binary jar; the manifest is
						     regenerated by maven-jar-plugin below -->
						<id>unpack-upstream</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<unzip src="${upstream.dir}/${project.artifactId}-${upstream.version}.jar" dest="${project.build.outputDirectory}">
									<patternset>
										<exclude name="META-INF/MANIFEST.MF"/>
									</patternset>
								</unzip>
							</target>
						</configuration>
					</execution>
					<execution>
						<!-- Maven Central requires a javadoc jar to be present;
						     no javadoc exists for this legacy binary artifact,
						     so a stub explaining that is packaged instead -->
						<id>javadoc-stub</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<jar destfile="${project.build.directory}/${project.build.finalName}-javadoc.jar" basedir="${project.basedir}/src/javadoc"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>gnu.prolog.test.GoalRunner</mainClass>
						</manifest>
						<manifestEntries>
							<!-- stabilizes the module name that GROOVE's
							     module-info requires; must never change -->
							<Automatic-Module-Name>gnuprologjava</Automatic-Module-Name>
							<Specification-Title>GNU Prolog for Java</Specification-Title>
							<Specification-Version>${upstream.version}</Specification-Version>
							<Specification-Vendor>http://www.gnu.org/software/gnuprologjava/</Specification-Vendor>
							<Implementation-Title>GNU Prolog for Java</Implementation-Title>
							<Implementation-Version>${upstream.version}</Implementation-Version>
							<Implementation-Vendor>http://www.gnu.org/software/gnuprologjava/</Implementation-Vendor>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>attach-sources-and-javadoc</id>
						<phase>package</phase>
						<goals>
							<goal>attach-artifact</goal>
						</goals>
						<configuration>
							<artifacts>
								<artifact>
									<file>${upstream.dir}/${project.artifactId}-${upstream.version}-sources.jar</file>
									<type>jar</type>
									<classifier>sources</classifier>
								</artifact>
								<artifact>
									<file>${project.build.directory}/${project.build.finalName}-javadoc.jar</file>
									<type>jar</type>
									<classifier>javadoc</classifier>
								</artifact>
							</artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>maven</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.9.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- deliberately not auto-published: validate the
							     bundle in the Central portal before releasing;
							     Central publications are irrevocable -->
							<autoPublish>false</autoPublish>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>verify-sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
